{#
    Application frame: one navigation element that is the sidebar from lg up and the top bar
    below, plus the bottom bar for phones and tablets held upright (see shell.css).

    The entries are described once as data: `prefixes` are the route-name prefixes that mark an
    entry as current, `paths` URL paths that do the same for everything below them, `tab` is the
    short label of an entry that also appears in the bottom bar, `children` turns an entry into a
    group. Expects `pageTitle` (may be empty; the label of the current entry is used then).
#}
{% set route = getActiveRouteName() %}
{% set requestPath = app.request.pathInfo %}
{% set items = [] %}

{% if is_granted('ROLE_RESERVATIONS') or is_granted('ROLE_RESERVATIONS_RO') %}
    {% set items = items|merge([{
        label: 'nav.reservation.overview'|trans, tab: 'nav.short.reservations'|trans, icon: 'fa-calendar-days',
        href: path('start'), prefixes: ['start', 'reservations'],
    }]) %}
{% endif %}
{% if is_granted('ROLE_OPERATIONS') %}
    {% set items = items|merge([{
        id: 'operations', label: 'nav.operations'|trans, icon: 'fa-concierge-bell', prefixes: ['operations.'], open: true,
        children: [
            { label: 'nav.operations.frontdesk'|trans, tab: 'nav.short.frontdesk'|trans, icon: 'fa-concierge-bell', href: path('operations.frontdesk'), prefixes: ['operations.frontdesk'] },
            { label: 'nav.housekeeping'|trans, icon: 'fa-broom', href: path('operations.housekeeping'), prefixes: ['operations.housekeeping'] },
            { label: 'nav.operations.reports'|trans, icon: 'fa-clipboard-list', href: path('operations.reports'), prefixes: ['operations.reports'] },
        ],
    }]) %}
{% endif %}
{% if is_granted('ROLE_CUSTOMERS') %}
    {% set items = items|merge([{
        label: 'nav.customers'|trans, tab: 'nav.customers'|trans, icon: 'fa-users',
        href: path('customers.overview'), prefixes: ['customers'],
    }]) %}
{% endif %}
{% if is_granted('ROLE_INVOICES') %}
    {% set items = items|merge([{
        label: 'nav.short.invoices'|trans, tab: 'nav.short.invoices'|trans, icon: 'fa-file-invoice',
        href: path('invoices.overview'), prefixes: ['invoices'],
    }]) %}
{% endif %}
{% if is_granted('ROLE_REGISTRATIONBOOK') %}
    {% set items = items|merge([{
        label: 'nav.registrationbook'|trans, icon: 'fa-book',
        href: path('registrationbook.overview'), prefixes: ['registrationbook'],
    }]) %}
{% endif %}
{% if is_granted('ROLE_CASHJOURNAL') %}
    {% set items = items|merge([{
        label: 'nav.journal'|trans, icon: 'fa-book-open',
        href: path('journal.overview'), prefixes: ['journal'],
    }]) %}
{% endif %}
{% if is_granted('ROLE_STATISTICS') %}
    {% set items = items|merge([{
        id: 'statistics', label: 'nav.statistics'|trans, icon: 'fa-chart-bar', prefixes: ['statistics'],
        children: [
            { label: 'nav.utilization'|trans, icon: 'fa-bed', href: path('statistics.utilization'), prefixes: ['statistics.utilization'] },
            { label: 'nav.origin'|trans, icon: 'fa-earth-europe', href: path('statistics.origin'), prefixes: ['statistics.origin'] },
            { label: 'nav.turnover'|trans, icon: 'fa-coins', href: path('statistics.turnover'), prefixes: ['statistics.turnover'] },
            { label: 'nav.tourism'|trans, icon: 'fa-suitcase-rolling', href: path('statistics.tourism'), prefixes: ['statistics.tourism'] },
        ],
    }]) %}
{% endif %}
{% if is_granted('ROLE_ADMIN') %}
    {# The settings pages are listed on the overview (Settings/index.html.twig); each names
       itself in the top bar with its page_title block #}
    {% set items = items|merge([{
        label: 'nav.settings'|trans, icon: 'fa-gear', href: path('settings.overview'), prefixes: [], paths: ['/settings'],
    }]) %}
{% endif %}

{# Mark the current entries, collect the bottom bar's tabs and find the title of the page #}
{% set marked = [] %}
{% set tabs = [] %}
{% set currentLabel = '' %}
{% for item in items %}
    {% set children = [] %}
    {% set childActive = false %}
    {% for child in item.children|default([]) %}
        {% set active = false %}
        {% for prefix in child.prefixes %}
            {% if route starts with prefix %}{% set active = true %}{% endif %}
        {% endfor %}
        {% if active %}
            {% set childActive = true %}
            {% set currentLabel = child.label %}
        {% endif %}
        {% set child = child|merge({ active: active }) %}
        {% set children = children|merge([child]) %}
        {% if child.tab is defined %}{% set tabs = tabs|merge([child]) %}{% endif %}
    {% endfor %}
    {% set active = childActive %}
    {% for prefix in item.prefixes %}
        {% if route starts with prefix %}{% set active = true %}{% endif %}
    {% endfor %}
    {% for basePath in item.paths|default([]) %}
        {% if requestPath == basePath or requestPath starts with basePath ~ '/' %}{% set active = true %}{% endif %}
    {% endfor %}
    {% if active and not childActive %}{% set currentLabel = item.label %}{% endif %}
    {% set item = item|merge({ active: active, children: children }) %}
    {% set marked = marked|merge([item]) %}
    {% if item.tab is defined %}{% set tabs = tabs|merge([item]) %}{% endif %}
{% endfor %}
{% set title = pageTitle|default('')|trim ?: currentLabel %}
{% set notifications = notification_summary() %}

<nav class="app-nav" aria-label="{{ 'nav.menu'|trans }}" data-controller="app-shell">
    <div class="app-nav-head">
        <a class="app-brand" href="{{ path('dashboard.redirect') }}" aria-label="FewohBee">
            <img src="{{ app.request.basepath }}/img/logo-fewohbee.png" alt="" width="28" height="28">
            <span class="app-brand-name"><span class="fewohbee-wordmark-blue">Fewoh</span><span class="fewohbee-wordmark-orange">Bee</span></span>
        </a>
        <span class="app-title">{{ title ?: 'FewohBee' }}</span>
        <button type="button" class="app-nav-rail-toggle" data-action="app-shell#toggleRail"
                title="{{ 'nav.sidebar.toggle'|trans }}" aria-label="{{ 'nav.sidebar.toggle'|trans }}">
            <span class="app-nav-rail-toggle-icon"><i class="fas fa-angles-left"></i></span>
        </button>
    </div>

    {# A side menu below lg (opened by "More" in the bottom bar), the sidebar's list from lg up #}
    <div class="offcanvas-lg offcanvas-end app-nav-menu" tabindex="-1" id="appNavMenu"
         data-controller="main-nav" aria-labelledby="appNavMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="appNavMenuLabel">{{ 'nav.menu'|trans }}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appNavMenu"
                    aria-label="{{ 'button.close'|trans }}"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="app-nav-list">
                {% for item in marked %}
                    {% if item.children is empty %}
                        <li>
                            <a class="app-nav-link{{ item.active ? ' active' }}" href="{{ item.href }}"
                               title="{{ item.label }}"{% if item.active %} aria-current="page"{% endif %}>
                                <span class="app-nav-icon"><i class="fas {{ item.icon }}"></i></span>
                                <span class="app-nav-label">{{ item.label }}</span>
                            </a>
                        </li>
                    {% else %}
                        {% set open = item.active or item.open|default(false) %}
                        <li>
                            <button type="button" class="app-nav-link{{ item.active ? ' active-group' }}"
                                    title="{{ item.label }}"
                                    data-action="app-shell#toggleGroup"
                                    aria-expanded="{{ open ? 'true' : 'false' }}" aria-controls="appNavGroup-{{ item.id }}">
                                <span class="app-nav-icon"><i class="fas {{ item.icon }}"></i></span>
                                <span class="app-nav-label">{{ item.label }}</span>
                                <span class="app-nav-caret"><i class="fas fa-chevron-down"></i></span>
                            </button>
                            <ul class="app-nav-sub collapse{{ open ? ' show' }}" id="appNavGroup-{{ item.id }}">
                                {% for child in item.children %}
                                    <li>
                                        <a class="app-nav-sublink{{ child.active ? ' active' }}" href="{{ child.href }}"
                                           {%- if child.active %} aria-current="page"{% endif %}>{{ child.label }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="app-nav-quick">
        <div class="dropdown" data-controller="notifications"
             data-notifications-url-value="{{ path('notifications.panel') }}">
            <a class="app-nav-link" href="#" id="navbarNotifications" role="button"
               data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
               data-action="show.bs.dropdown->notifications#loadPanelAction"
               title="{{ 'notification.title'|trans }}" aria-label="{{ 'notification.title'|trans }}">
                <span class="app-nav-icon"><i class="fas fa-bell"></i></span>
                <span class="app-nav-label">{{ 'notification.title'|trans }}</span>
                <span class="app-nav-badge badge rounded-pill {{ notifications.badgeClass }}{{ notifications.isEmpty ? ' d-none' : '' }}"
                      data-notifications-badge>
                    <span data-notifications-count>{{ notifications.total }}</span>
                    <span class="visually-hidden">{{ 'notification.title'|trans }}</span>
                </span>
            </a>
            <div class="dropdown-menu notification-panel" aria-labelledby="navbarNotifications"
                 data-notifications-target="panel">
                <div class="px-3 py-4 text-center text-body-secondary">
                    <span class="spinner-border spinner-border-sm"></span>
                </div>
            </div>
        </div>
        <div class="dropdown">
            <a class="app-nav-link" href="#" id="appNavUser" role="button" data-bs-toggle="dropdown"
               aria-expanded="false" title="{{ app.user.getUsername() }}" aria-label="{{ 'nav.profile'|trans }}">
                <span class="app-nav-icon"><i class="fas fa-user-circle"></i></span>
                <span class="app-nav-label">{{ app.user.getUsername() }}</span>
            </a>
            <div class="dropdown-menu" aria-labelledby="appNavUser">
                <a class="dropdown-item" href="{{ path('profile') }}"><i class="fas fa-user fa-fw me-2"></i>{{ 'nav.profile'|trans }}</a>
                <a class="dropdown-item d-flex align-items-center" href="{{ path('release_notes.index') }}">
                    <i class="fas fa-gift fa-fw me-2"></i>
                    <span>{{ 'release_notes.nav'|trans }}</span>
                    <span class="text-body-secondary small ms-auto ps-3">{{ app_version }}</span>
                </a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="{{ path('logout') }}"><i class="fas fa-sign-out-alt fa-fw me-2"></i>{{ 'nav.logout'|trans }}</a>
            </div>
        </div>
    </div>
</nav>

{#
    Bottom bar: the four tabs always, then as many other pages as fit beside them under their full
    names, in menu order; "More" opens a sheet from below with the rest as tiles, grouped like the
    side menu. CSS decides by the width of the screen, so nothing moves after loading: a page
    needs a slot of 70 px or the width of its name (about 6.7 px a letter at the bar's size, bold),
    and "More" another 70 px while something is left for it. `fit` is the screen width from which a
    page stands in the bar (app-bottomnav-from-*) and leaves the sheet (app-more-until-*), rounded up
    to the 20 px steps shell.css knows (1000: never in the bar, which ends at lg). #}
{% set barTabs = tabs|slice(0, 4) %}
{% set barHrefs = barTabs|map(tab => tab.href) %}
{% set extras = [] %}
{% for item in marked %}
    {% if item.children is empty %}
        {% if item.href not in barHrefs %}{% set extras = extras|merge([item]) %}{% endif %}
    {% else %}
        {% for child in item.children|filter(child => child.href not in barHrefs) %}
            {% set extras = extras|merge([child|merge({ icon: child.icon|default(item.icon) })]) %}
        {% endfor %}
    {% endif %}
{% endfor %}
{% set used = 8 + 70 * barTabs|length %}
{% set fit = {} %}
{% for extra in extras %}
    {% set used = used + max(70, (extra.label|length * 6.7 + 6)|round(0, 'ceil')) %}
    {% set need = loop.last ? used : used + 70 %}
    {% set fit = fit|merge({ (extra.href): min(1000, (need / 20)|round(0, 'ceil') * 20)|number_format(0, '', '') }) %}
{% endfor %}
{% set allFit = extras is empty ? 0 : fit[extras|last.href] %}
{# "More" is marked while the current page is behind it, up to the width that moves it into the bar #}
{% set activeExtra = extras|filter(extra => extra.active)|first %}
<nav class="app-bottomnav" aria-label="{{ 'nav.menu'|trans }}">
    {% for tab in barTabs %}
        <a class="app-bottomnav-item{{ tab.active ? ' active' }}" href="{{ tab.href }}"{% if tab.active %} aria-current="page"{% endif %}>
            <span class="app-bottomnav-icon"><i class="fas {{ tab.icon }}"></i></span>
            <span class="app-bottomnav-label">{{ tab.tab }}</span>
        </a>
    {% endfor %}
    {% for extra in extras %}
        <a class="app-bottomnav-item app-bottomnav-from-{{ fit[extra.href] }}{{ extra.active ? ' active' }}" href="{{ extra.href }}"{% if extra.active %} aria-current="page"{% endif %}>
            <span class="app-bottomnav-icon"><i class="fas {{ extra.icon }}"></i></span>
            <span class="app-bottomnav-label">{{ extra.label }}</span>
        </a>
    {% endfor %}
    {% if extras is not empty %}
        <button type="button" class="app-bottomnav-item app-more-until-{{ allFit }}{{ activeExtra ? ' active app-more-active-until-' ~ fit[activeExtra.href] }}" data-bs-toggle="offcanvas"
                data-bs-target="#appMoreSheet" aria-controls="appMoreSheet">
            <span class="app-bottomnav-icon"><i class="fas fa-grip"></i></span>
            <span class="app-bottomnav-label">{{ 'nav.more'|trans }}</span>
        </button>
    {% endif %}
</nav>

<div class="offcanvas offcanvas-bottom app-more-sheet" tabindex="-1" id="appMoreSheet"
     aria-labelledby="appMoreSheetLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="appMoreSheetLabel">{{ 'nav.more'|trans }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appMoreSheet"
                aria-label="{{ 'button.close'|trans }}"></button>
    </div>
    <div class="offcanvas-body">
        {# Entries without a group together on top, then each group under its heading: an entry
           between two groups would look like a part of the group above it. A section leaves with
           its last tile. #}
        {% set loose = extras|filter(extra => extra.children is defined and extra.children is empty) %}
        {% set sections = loose is empty ? [] : [{ tiles: loose }] %}
        {% for item in marked|filter(item => item.children is not empty) %}
            {% set rest = extras|filter(extra => extra.href in item.children|map(child => child.href)) %}
            {% if rest is not empty %}{% set sections = sections|merge([{ id: item.id, label: item.label, tiles: rest }]) %}{% endif %}
        {% endfor %}
        {% for section in sections %}
            <div class="app-more-section app-more-until-{{ fit[section.tiles|last.href] }}">
                {% if section.label is defined %}
                    <h6 class="app-more-heading" id="appMoreGroup-{{ section.id }}">{{ section.label }}</h6>
                {% endif %}
                <ul class="app-more-grid"{% if section.label is defined %} aria-labelledby="appMoreGroup-{{ section.id }}"{% endif %}>
                    {% for tile in section.tiles %}
                        <li class="app-more-until-{{ fit[tile.href] }}">
                            <a class="app-more-tile{{ tile.active ? ' active' }}" href="{{ tile.href }}"{% if tile.active %} aria-current="page"{% endif %}>
                                <span class="app-more-icon"><i class="fas {{ tile.icon }}"></i></span>
                                <span class="app-more-label">{{ tile.label }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </div>
</div>
