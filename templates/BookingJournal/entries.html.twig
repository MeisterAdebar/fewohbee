{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}
{% import _self as journal %}

{% block title %}
    {{ parent() }} - {{ 'nav.journal'|trans }} - {{ getLocalizedMonth(batch.month, 'MMMM', app.request.locale) }} {{ batch.year }}
{% endblock %}

{% block flashMessage %}
    {% include 'BookingJournal/_flash_messages.html.twig' %}
{% endblock %}

{% block content %}
{# fit-rows: as many entries per page as fit the screen, see ListPageSizeService #}
<div class="container fit-rows-fluid fit-rows" data-controller="booking-journal swipe-nav fit-rows"
     data-fit-rows-cookie-value="journal_rows" data-fit-rows-per-page-value="{{ perPage }}"
     data-fit-rows-page-value="{{ page }}" data-fit-rows-total-value="{{ total }}">
    <div class="row justify-content-between mb-3">
        <div class="col d-flex align-items-center gap-3 flex-wrap">
            <h4 class="mb-0 text-nowrap">{{ getLocalizedMonth(batch.month, 'MMMM', app.request.locale) }} {{ batch.year }}</h4>
            <select class="form-select form-select-sm" style="width: 12rem"
                    onchange="window.location.href='{{ path('journal.batch.entries', {'id': batch.id}) }}?filter=' + this.value">
                <option value="all"{% if filter == 'all' %} selected{% endif %}>{{ 'accounting.journal.filter.all'|trans }}</option>
                <option value="cashbook"{% if filter == 'cashbook' %} selected{% endif %}>{{ 'accounting.journal.filter.cashbook'|trans }}</option>
                <option value="bankbook"{% if filter == 'bankbook' %} selected{% endif %}>{{ 'accounting.journal.filter.bankbook'|trans }}</option>
            </select>
        </div>
        <div class="col-auto d-flex flex-wrap gap-2 align-items-center">
            {% if batch.closed %}
                <span class="badge bg-secondary"><i class="fas fa-lock"></i> {{ 'accounting.journal.batch.closed'|trans }}</span>
            {% endif %}
            {% if not batch.closed %}
                <button type="button" class="btn btn-secondary btn-sm fab-add-inline"
                        data-action="click->booking-journal#openOffcanvas"
                        data-url="{{ path('journal.entry.new', {'id': batch.id, 'filter': filter, 'page': page}) }}"
                        data-offcanvas-title="{{ 'accounting.journal.entry.add'|trans }}">
                    <i class="fas fa-plus"></i> {{ 'accounting.journal.entry.add'|trans }}
                </button>
                {# Touch screens: the same as a floating button, see "Add button on touch screens" in app.css #}
                <button type="button" class="btn fab-add"
                        data-action="click->booking-journal#openOffcanvas"
                        data-url="{{ path('journal.entry.new', {'id': batch.id, 'filter': filter, 'page': page}) }}"
                        data-offcanvas-title="{{ 'accounting.journal.entry.add'|trans }}"
                        title="{{ 'accounting.journal.entry.add'|trans }}" aria-label="{{ 'accounting.journal.entry.add'|trans }}">
                    <i class="fas fa-plus"></i>
                </button>
            {% endif %}
            {% if batch.closed and is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('journal.batch.toggle_status', {'id': batch.id}) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('batch_toggle_' ~ batch.id) }}">
                    <button type="submit" class="btn btn-outline-warning btn-sm">
                        <i class="fas fa-lock-open"></i> {{ 'accounting.journal.batch.reopen'|trans }}
                    </button>
                </form>
            {% elseif not batch.closed %}
                <form method="post" action="{{ path('journal.batch.toggle_status', {'id': batch.id}) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('batch_toggle_' ~ batch.id) }}">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-lock"></i> {{ 'accounting.journal.batch.close'|trans }}
                    </button>
                </form>
            {% endif %}
            {# In the heading row rather than a row of its own: the rows below get the height #}
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-download"></i> {{ 'accounting.journal.export'|trans }}
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item"
                           href="{{ path('journal.batch.export.datev', {'id': batch.id}) }}"
                           data-turbo="false"
                           data-turbo-prefetch="false">
                            <i class="fas fa-file-csv"></i> {{ 'accounting.journal.export.datev'|trans }}
                        </a>
                    </li>
                    {% for tmpl in pdfTemplates %}
                        <li>
                            <a class="dropdown-item" href="{{ path('journal.batch.export.pdf', {'id': batch.id, 'templateId': tmpl.id}) }}" target="_blank">
                                <i class="fas fa-file-pdf"></i> {{ tmpl.name }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>


    {% if filter == 'bankbook' %}
        {# ── Bankbuch view ── #}
        <div class="row mb-2">
            <div class="col-auto"><strong>{{ 'accounting.journal.bankbook.start'|trans }}:</strong> {{ bankOpeningBalance|number_format(2, ',', '.') }} &euro;</div>
            <div class="col-auto"><strong>{{ 'accounting.journal.bankbook.end'|trans }}:</strong> {{ bankClosingBalance|number_format(2, ',', '.') }} &euro;</div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm fit-rows-table journal-entries-table">
                <thead>
                <tr>
                    <th>{{ 'accounting.journal.entry.date'|trans }}</th>
                    <th class="journal-doc-number">{{ 'accounting.journal.entry.doc_number'|trans }}</th>
                    <th class="text-end">{{ 'accounting.journal.bankbook.incomes'|trans }}</th>
                    <th class="text-end">{{ 'accounting.journal.bankbook.expenses'|trans }}</th>
                    <th class="fit-rows-cut">{{ 'accounting.journal.bankbook.counter_account'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'accounting.journal.entry.tax_rate'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'accounting.journal.entry.invoice'|trans }}</th>
                    <th class="journal-text">{{ 'accounting.journal.entry.remark'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody data-fit-rows-target="rows">
                {% for entry in entries %}
                    {% set isIncome = entry.debitAccount and entry.debitAccount.bankAccount %}
                    {% set isExpense = entry.creditAccount and entry.creditAccount.bankAccount %}
                    <tr>
                        <td>{{ entry.date|date('d.m.') }}<span class="journal-date-year">{{ entry.date|date('Y') }}</span></td>
                        <td class="journal-doc-number">{{ '%04d'|format(entry.documentNumber) }}</td>
                        <td class="text-end">{{ isIncome ? entry.amountFloat|abs|number_format(2, ',', '.') : '' }}</td>
                        <td class="text-end">{{ isExpense ? entry.amountFloat|abs|number_format(2, ',', '.') : '' }}</td>
                        <td class="fit-rows-cut">
                            {% if isIncome and entry.creditAccount %}
                                {{ journal.account(entry.creditAccount) }}
                            {% elseif isExpense and entry.debitAccount %}
                                {{ journal.account(entry.debitAccount) }}
                            {% else %}
                                {{ entry.counterAccountLegacy ?? '-' }}
                            {% endif %}
                        </td>
                        <td class="d-none d-md-table-cell">{{ entry.taxRate ? entry.taxRate.name : '-' }}</td>
                        <td class="d-none d-md-table-cell">{% if entry.missingDocumentNumber %}<span class="badge text-bg-warning" title="{{ 'accounting.journal.entry.missing_document_hint'|trans }}">{{ 'accounting.journal.entry.missing_document'|trans }}</span>{% else %}{{ entry.invoiceNumber ?? '-' }}{% endif %}</td>
                        <td class="journal-text">{{ entry.remark ?? '' }}</td>
                        <td>
                            {% if not batch.closed %}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        data-action="click->booking-journal#openOffcanvas"
                                        data-url="{{ path('journal.entry.edit', {'id': entry.id, 'filter': filter, 'page': page}) }}"
                                        data-offcanvas-title="{{ 'accounting.journal.entry.edit'|trans }}"
                                        title="{{ 'button.edit'|trans }}">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        data-action="click->booking-journal#openOffcanvas"
                                        data-url="{{ path('journal.entry.duplicate', {'id': entry.id, 'filter': filter, 'page': page}) }}"
                                        data-offcanvas-title="{{ 'accounting.journal.entry.duplicate'|trans }}"
                                        title="{{ 'accounting.journal.entry.duplicate'|trans }}">
                                    <i class="fas fa-copy"></i>
                                </button>
                                {% set id = entry.id %}
                                {% set targetUrl = path('journal.entry.delete', {'id': entry.id}) %}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        title="{{ 'button.delete'|trans }}"
                                        data-popover="delete"
                                        data-title="{{ 'accounting.journal.entry.delete_ask'|trans }}"
                                        data-bs-content='{{ block('deletePopoverContent') }}'>
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="9" class="text-center text-muted">{{ 'accounting.journal.entry.empty'|trans }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% elseif filter == 'cashbook' %}
        {# ── Kassenbuch view ── #}
        <div class="row mb-2">
            <div class="col-auto"><strong>{{ 'accounting.journal.cashbook.start'|trans }}:</strong> {{ batch.cashStart|number_format(2, ',', '.') }} &euro;</div>
            <div class="col-auto"><strong>{{ 'accounting.journal.cashbook.end'|trans }}:</strong> {{ batch.cashEnd|number_format(2, ',', '.') }} &euro;</div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm fit-rows-table journal-entries-table">
                <thead>
                <tr>
                    <th>{{ 'accounting.journal.entry.date'|trans }}</th>
                    <th class="journal-doc-number">{{ 'accounting.journal.entry.doc_number'|trans }}</th>
                    <th class="text-end">{{ 'accounting.journal.cashbook.incomes'|trans }}</th>
                    <th class="text-end">{{ 'accounting.journal.cashbook.expenses'|trans }}</th>
                    <th class="fit-rows-cut">{{ 'accounting.journal.cashbook.counter_account'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'accounting.journal.entry.invoice'|trans }}</th>
                    <th class="journal-text">{{ 'accounting.journal.entry.remark'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody data-fit-rows-target="rows">
                {% for entry in entries %}
                    {% set isIncome = entry.debitAccount and entry.debitAccount.cashAccount %}
                    {% set isExpense = entry.creditAccount and entry.creditAccount.cashAccount %}
                    <tr>
                        <td>{{ entry.date|date('d.m.') }}<span class="journal-date-year">{{ entry.date|date('Y') }}</span></td>
                        <td class="journal-doc-number">{{ '%04d'|format(entry.documentNumber) }}</td>
                        <td class="text-end">{{ isIncome ? entry.amountFloat|abs|number_format(2, ',', '.') : '' }}</td>
                        <td class="text-end">{{ isExpense ? entry.amountFloat|abs|number_format(2, ',', '.') : '' }}</td>
                        <td class="fit-rows-cut">
                            {% if isIncome and entry.creditAccount %}
                                {{ journal.account(entry.creditAccount) }}
                            {% elseif isExpense and entry.debitAccount %}
                                {{ journal.account(entry.debitAccount) }}
                            {% else %}
                                {{ entry.counterAccountLegacy ?? '-' }}
                            {% endif %}
                        </td>
                        <td class="d-none d-md-table-cell">{% if entry.missingDocumentNumber %}<span class="badge text-bg-warning" title="{{ 'accounting.journal.entry.missing_document_hint'|trans }}">{{ 'accounting.journal.entry.missing_document'|trans }}</span>{% else %}{{ entry.invoiceNumber ?? '-' }}{% endif %}</td>
                        <td class="journal-text">{{ entry.remark ?? '' }}</td>
                        <td>
                            {% if not batch.closed %}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        data-action="click->booking-journal#openOffcanvas"
                                        data-url="{{ path('journal.entry.edit', {'id': entry.id, 'filter': filter, 'page': page}) }}"
                                        data-offcanvas-title="{{ 'accounting.journal.entry.edit'|trans }}"
                                        title="{{ 'button.edit'|trans }}">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        data-action="click->booking-journal#openOffcanvas"
                                        data-url="{{ path('journal.entry.duplicate', {'id': entry.id, 'filter': filter, 'page': page}) }}"
                                        data-offcanvas-title="{{ 'accounting.journal.entry.duplicate'|trans }}"
                                        title="{{ 'accounting.journal.entry.duplicate'|trans }}">
                                    <i class="fas fa-copy"></i>
                                </button>
                                {% set id = entry.id %}
                                {% set targetUrl = path('journal.entry.delete', {'id': entry.id}) %}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        title="{{ 'button.delete'|trans }}"
                                        data-popover="delete"
                                        data-title="{{ 'accounting.journal.entry.delete_ask'|trans }}"
                                        data-bs-content='{{ block('deletePopoverContent') }}'>
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-center text-muted">{{ 'accounting.journal.entry.empty'|trans }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        {# ── Journal view (all entries) ── #}
        {# On touch screens debit and credit share the room left by the other columns in
           proportion to their longest label on the page, see app.css #}
        {% set debitChars = 1 %}
        {% set creditChars = 1 %}
        {% for entry in entries %}
            {% set debitChars = max(debitChars, (entry.debitAccount ? entry.debitAccount.label : (entry.counterAccountLegacy ?? '-'))|length) %}
            {% set creditChars = max(creditChars, (entry.creditAccount ? entry.creditAccount.label : '-')|length) %}
        {% endfor %}
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm fit-rows-table journal-entries-table">
                <thead>
                <tr>
                    <th>{{ 'accounting.journal.entry.date'|trans }}</th>
                    <th class="journal-doc-number">{{ 'accounting.journal.entry.doc_number'|trans }}</th>
                    <th class="text-end">{{ 'accounting.journal.entry.amount'|trans }}</th>
                    <th class="fit-rows-cut" style="--fit-rows-share: {{ (100 * debitChars / (debitChars + creditChars))|round(1) }}%">{{ 'accounting.journal.entry.debit'|trans }}</th>
                    <th class="fit-rows-cut" style="--fit-rows-share: {{ (100 * creditChars / (debitChars + creditChars))|round(1) }}%">{{ 'accounting.journal.entry.credit'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'accounting.journal.entry.tax_rate'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'accounting.journal.entry.invoice'|trans }}</th>
                    <th class="journal-text">{{ 'accounting.journal.entry.remark'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody data-fit-rows-target="rows">
                {% for entry in entries %}
                    <tr>
                        <td>{{ entry.date|date('d.m.') }}<span class="journal-date-year">{{ entry.date|date('Y') }}</span></td>
                        <td class="journal-doc-number">{{ '%04d'|format(entry.documentNumber) }}</td>
                        <td class="text-end">{{ entry.amount|number_format(2, ',', '.') }}</td>
                        <td class="fit-rows-cut">{{ entry.debitAccount ? journal.account(entry.debitAccount) : (entry.counterAccountLegacy ?? '-') }}</td>
                        <td class="fit-rows-cut">{{ entry.creditAccount ? journal.account(entry.creditAccount) : '-' }}</td>
                        <td class="d-none d-md-table-cell">{{ entry.taxRate ? entry.taxRate.name : '-' }}</td>
                        <td class="d-none d-md-table-cell">{% if entry.missingDocumentNumber %}<span class="badge text-bg-warning" title="{{ 'accounting.journal.entry.missing_document_hint'|trans }}">{{ 'accounting.journal.entry.missing_document'|trans }}</span>{% else %}{{ entry.invoiceNumber ?? '-' }}{% endif %}</td>
                        <td class="journal-text">{{ entry.remark ?? '' }}</td>
                        <td>
                            {% if not batch.closed %}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        data-action="click->booking-journal#openOffcanvas"
                                        data-url="{{ path('journal.entry.edit', {'id': entry.id, 'filter': filter, 'page': page}) }}"
                                        data-offcanvas-title="{{ 'accounting.journal.entry.edit'|trans }}"
                                        title="{{ 'button.edit'|trans }}">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        data-action="click->booking-journal#openOffcanvas"
                                        data-url="{{ path('journal.entry.duplicate', {'id': entry.id, 'filter': filter, 'page': page}) }}"
                                        data-offcanvas-title="{{ 'accounting.journal.entry.duplicate'|trans }}"
                                        title="{{ 'accounting.journal.entry.duplicate'|trans }}">
                                    <i class="fas fa-copy"></i>
                                </button>
                                {% set id = entry.id %}
                                {% set targetUrl = path('journal.entry.delete', {'id': entry.id}) %}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0"
                                        title="{{ 'button.delete'|trans }}"
                                        data-popover="delete"
                                        data-title="{{ 'accounting.journal.entry.delete_ask'|trans }}"
                                        data-bs-content='{{ block('deletePopoverContent') }}'>
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="9" class="text-center text-muted">{{ 'accounting.journal.entry.empty'|trans }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {# Centred, so it does not shift as the number of pages changes with the page size;
       on touch screens clear of the floating add button, see app.css. Back to the
       overview goes through the navbar. #}
    <div class="d-flex justify-content-center fit-rows-paging">
        {% include 'paginator.html.twig' with { 'url': path('journal.batch.entries', {'id': batch.id, 'filter': filter}), 'search': search } %}
    </div>

    {# Edge arrows and swipes page through the entries first and only then
       change the month; back from the first page lands on the last page of
       the previous month, so the entries read on without a gap #}
    {% if page < pages %}
        {% set edgeNextUrl = path('journal.batch.entries', {'id': batch.id, 'filter': filter, 'page': page + 1, 'search': search}) %}
        {% set edgeNextLabel = 'accounting.journal.batch.next_page'|trans({'%page%': page + 1, '%pages%': pages}) %}
    {% elseif nextBatch %}
        {% set edgeNextUrl = path('journal.batch.entries', {'id': nextBatch.id, 'filter': filter}) %}
        {% set edgeNextLabel = 'accounting.journal.batch.next_month'|trans({'%month%': getLocalizedMonth(nextBatch.month, 'MMMM', app.request.locale) ~ ' ' ~ nextBatch.year}) %}
    {% endif %}
    {% if page > 1 %}
        {% set edgePreviousUrl = path('journal.batch.entries', {'id': batch.id, 'filter': filter, 'page': page - 1, 'search': search}) %}
        {% set edgePreviousLabel = 'accounting.journal.batch.previous_page'|trans({'%page%': page - 1, '%pages%': pages}) %}
    {% elseif previousBatch %}
        {% set edgePreviousUrl = path('journal.batch.entries', {'id': previousBatch.id, 'filter': filter, 'page': previousBatchLastPage}) %}
        {% set edgePreviousLabel = 'accounting.journal.batch.previous_month'|trans({'%month%': getLocalizedMonth(previousBatch.month, 'MMMM', app.request.locale) ~ ' ' ~ previousBatch.year}) %}
    {% endif %}
    {% include 'BookingJournal/_edge_navigation.html.twig' with {
        'previousUrl': edgePreviousUrl|default(''), 'previousLabel': edgePreviousLabel|default(''),
        'nextUrl': edgeNextUrl|default(''), 'nextLabel': edgeNextLabel|default('')
    } %}

    {# ── Offcanvas ─────────────────────────────────────── #}
    <div class="offcanvas offcanvas-end" tabindex="-1" id="journalOffcanvas"
         data-booking-journal-target="offcanvas">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" data-booking-journal-target="offcanvasTitle"></h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" data-booking-journal-target="offcanvasBody">
        </div>
    </div>
</div>
{% endblock %}

{# An account as number and name; on touch screens the name is left out to keep the
   table within the screen width, see app.css #}
{% macro account(account) %}{{ account.accountNumber }}<span class="journal-account-name"> - {{ account.name }}</span>{% endmacro %}
