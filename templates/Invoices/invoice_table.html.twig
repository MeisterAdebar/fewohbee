{# The invoice list of the overview; reloaded on its own by invoices_controller.js when searching or paging #}
{% set total = invoices.count %}
{# paged-list: its paging stays at the bottom of the screen while the rows scroll, and is
   compact on touch screens (records.css, touch.css). The count stands in the search field,
   which takes it from here after a search (search_count.js). #}
<div class="paged-list" data-search-count="{{ total }}" data-search-count-label="{{ 'invoice.list.count'|trans({'%count%': total}) }}">
{% if total == 0 %}
    <twig:EmptyState icon="file-invoice" :title="'invoice.list.empty'|trans">
        {{- 'invoice.list.empty.hint'|trans -}}
    </twig:EmptyState>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle data-table data-table-stack invoice-table touch-table" data-controller="row-link" data-action="click->row-link#open">
            <thead>
            <tr>
                <th class="text-center"><span class="touch-table-long">{{ 'invoice.number'|trans }}</span><span class="touch-table-short"><span class="touch-table-phone-hidden">{{ 'invoice.number.header.short'|trans }}</span><span class="touch-table-phone-only">{{ 'invoice.number.header.phone'|trans }}</span></span></th>
                <th class="text-center"><span class="touch-table-long">{{ 'invoice.date'|trans }}</span><span class="touch-table-short">{{ 'invoice.date.short'|trans }}</span></th>
                <th class="touch-table-cut" style="--touch-table-share: 55%">{{ 'invoice.list.name'|trans }}</th>
                <th class="touch-table-cut" style="--touch-table-share: 45%">{{ 'invoice.company'|trans }}</th>
                <th class="text-center">{{ 'invoice.status'|trans }}</th>
                <th class="data-table-actions"><span class="visually-hidden">{{ 'invoice.action'|trans }}</span></th>
            </tr>
            </thead>
            <tbody>
            {% for invoice in invoices %}
                {% set name = invoice.lastname ~ (invoice.firstname is not empty and invoice.lastname is not empty ? ', ') ~ invoice.firstname %}
                {% set readiness = einvoiceReadiness[invoice.id] ?? null %}
                {% set title = 'invoice.number.short'|trans ~ ' ' ~ invoice.number %}
                <tr>
                    <td class="text-center">
                        <a href="#" class="data-table-link" data-row-link-target="link"
                           data-action="click->invoices#showInvoiceAction"
                           data-url="{{ path('invoices.get.invoice', {'id': invoice.id}) }}"
                           data-title="{{ title }}"
                           data-bs-toggle="modal" data-bs-target="#modalCenter"
                           title="{{ 'button.details'|trans }}">
                            <span class="data-table-link-text">
                                {{- invoice.number -}}
                                {% if name is not empty %}<span class="cell-narrow fw-normal"> · {{ name }}</span>{% endif %}
                            </span>
                        </a>
                    </td>
                    <td class="cell-wide text-nowrap text-center">{{ invoice.date|date('d.m.') }}<span class="touch-table-phone-hidden">{{ invoice.date|date('Y') }}</span></td>
                    <td class="cell-wide touch-table-cut">{{ name }}</td>
                    <td class="cell-meta touch-table-cut">{{- invoice.company -}}</td>
                    <td class="cell-meta text-center">
                        <span class="invoice-state">
                            <span class="cell-narrow">{{ invoice.date|date('d.m.Y') }}</span>
                            <twig:InvoiceStatus :status="invoice.status"/>
                            {# The way of payment; on phones held sideways in the colour of the status
                               instead of the badge (invoices.css), a receipt where none is set. Its
                               tooltip names both. #}
                            {% set statusKey = {1: 'unpaid', 2: 'paid', 3: 'prepaid'}[invoice.status] ?? 'canceled' %}
                            {% set paymentMeansIcon = invoice.paymentMeans ? ({
                                'CASH': 'fa-coins',
                                'CREDIT_TRANSFER': 'fa-building-columns',
                                'CARD_PAYMENT': 'fa-credit-card',
                                'SEPA_CREDIT_TRANSFER': 'fa-building-columns',
                                'SEPA_DIRECT_DEBIT': 'fa-money-check'
                            }[invoice.paymentMeans.name]|default('fa-circle-question')) : 'fa-receipt' %}
                            {% set paymentLabel = invoice.paymentMeans
                                ? invoice.paymentMeans.name|trans ~ ' · ' ~ ('invoice.status.' ~ statusKey)|trans
                                : ('invoice.status.' ~ statusKey)|trans %}
                            <span class="invoice-state-means invoice-state-{{ statusKey }}{% if not invoice.paymentMeans %} invoice-state-means-none{% endif %}"
                                  role="img" data-bs-toggle="tooltip" data-row-link-ignore
                                  title="{{ paymentLabel }}" aria-label="{{ paymentLabel }}">
                                <i class="fa-solid {{ paymentMeansIcon }}" aria-hidden="true"></i>
                            </span>
                            {# Per invoice, not list-wide: with per-branch issuers the profile can differ.
                               The icons explain themselves in a tooltip, on touch screens with a tap:
                               a tap on them does not open the invoice (data-row-link-ignore). #}
                            {% if readiness and readiness.configured %}
                                {% if readiness.ready %}
                                    {% set einvoice = {class: 'text-success-emphasis', icon: 'circle-check', text: 'invoice.einvoice.status.ready'|trans} %}
                                {% else %}
                                    {# a company recipient is likely B2B, where the e-invoice matters → warning;
                                       otherwise likely B2C, where it is not mandatory → neutral info #}
                                    {% set einvoice = {
                                        class: invoice.company is not empty ? 'text-warning-emphasis' : 'text-info-emphasis',
                                        icon: invoice.company is not empty ? 'triangle-exclamation' : 'circle-info',
                                        text: 'invoice.einvoice.status.missing'|trans ~ ':' ~ "\n" ~ readiness.result.messageKeys|map(key => key|trans)|join("\n"),
                                    } %}
                                {% endif %}
                                <span class="invoice-state-einvoice {{ einvoice.class }}" role="img"
                                      data-bs-toggle="tooltip" data-bs-custom-class="invoice-state-tooltip" data-row-link-ignore title="{{ einvoice.text }}" aria-label="{{ einvoice.text }}">
                                    <i class="fa-solid fa-{{ einvoice.icon }}" aria-hidden="true"></i>
                                </span>
                            {% endif %}
                        </span>
                    </td>
                    <td class="cell-actions data-table-actions text-end">
                        <twig:IconButton icon="pen" :label="'button.edit'|trans"
                                         data-action="click->invoices#showInvoiceAction"
                                         data-edit="true"
                                         data-url="{{ path('invoices.get.invoice', {'id': invoice.id}) }}"
                                         data-title="{{ title }}"
                                         data-bs-toggle="modal" data-bs-target="#modalCenter"/>
                        <twig:IconButton icon="file-pdf" class="export-link" target="_blank"
                                         :label="readiness and readiness.ready ? 'button.export.einvoicepdf'|trans : 'button.export.pdf'|trans"
                                         :href="path('invoices.export.pdf', {'id': invoice.id, 'template': templateId})"/>
                        {% if readiness and readiness.profileKey == 'xrechnung' %}
                            <twig:IconButton icon="file-code" :label="'button.export.xml'|trans"
                                             :href="path('invoices.export.xrechnung', {'id': invoice.id})"/>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
<div class="data-footer">
    <span></span>
    <input id="page" type="hidden" name="page" value="{{ page }}" />
    {% include 'paginator.html.twig' with { 'url' : path('invoices.overview'), 'pagination_action': 'click->invoices#paginateAction', 'swipe_nav': true } %}
</div>
</div>
