{# swipe-nav: a sideways swipe pages, through the arrows of the paginator.
   fit-rows: as many invoices per page as fit the screen, see ListPageSizeService. Inside the
   part the search replaces, so a new result measures again. On touch screens name and
   company share the width in proportion to their longest text on the page, see app.css. #}
{% set lastnameChars = max([1]|merge(invoices|map(invoice => invoice.lastname|length))) %}
{% set companyChars = max([1]|merge(invoices|map(invoice => invoice.company|length))) %}
<div class="fit-rows" data-controller="fit-rows swipe-nav"
     data-fit-rows-cookie-value="invoices_rows" data-fit-rows-per-page-value="{{ perPage }}"
     data-fit-rows-page-value="{{ page }}" data-fit-rows-total-value="{{ total }}"
     data-fit-rows-search-value="{{ search }}">
<div class="table-responsive">
<table class="table table-bordered table-hover fit-rows-table">
    <thead>
    <tr>
        <th><span class="fit-rows-phone-hidden">{{ 'invoice.number'|trans }}</span><span class="fit-rows-phone-only">{{ 'invoice.number.column_short'|trans }}</span></th>
        <th><span class="fit-rows-long">{{ 'invoice.date'|trans }}</span><span class="fit-rows-short">{{ 'invoice.date2'|trans }}</span></th>
        <th class="fit-rows-cut" style="--fit-rows-share: {{ (100 * lastnameChars / (lastnameChars + companyChars))|round(1) }}%">{{ 'invoice.lastname'|trans }}</th>
        <th class="fit-rows-cut" style="--fit-rows-share: {{ (100 * companyChars / (lastnameChars + companyChars))|round(1) }}%">{{ 'invoice.company'|trans }}</th>
        <th><span class="fit-rows-phone-hidden">{{ 'invoice.status'|trans }}</span><span class="fit-rows-phone-only" title="{{ 'invoice.status'|trans }}">{{ 'invoice.status.column_short'|trans }}</span></th>
        <th>{{ 'invoice.action'|trans }}</th>
    </tr>
    </thead>
    <tbody data-fit-rows-target="rows">
    {% for invoice in invoices %}
        <tr>
            <td>{{ invoice.number }}</td>
            <td>{{ invoice.date|date('d.m.') }}<span class="fit-rows-phone-hidden">{{ invoice.date|date('Y') }}</span></td>
            <td class="fit-rows-cut">{{ invoice.lastname }}</td>
            <td class="fit-rows-cut">{{ invoice.company }}</td>
            <td>
                {# On a phone the status shows as an icon only, see app.css #}
                {% set status = {
                    1: ['invoice.status.unpaid', 'fa-hourglass-half text-warning'],
                    2: ['invoice.status.paid', 'fa-circle-check text-success'],
                    3: ['invoice.status.prepaid', 'fa-circle-check text-info']
                }[invoice.status]|default(['invoice.status.canceled', 'fa-ban text-body-secondary']) %}
                <span class="fit-rows-phone-hidden">{{ status[0]|trans }}</span>
                <span class="fit-rows-phone-only" title="{{ status[0]|trans }}" aria-label="{{ status[0]|trans }}">
                    <i class="fa-solid {{ status[1] }}" aria-hidden="true"></i></span>
                {% if invoice.paymentMeans %}
                    {% set paymentMeansIcon = {
                        'CASH': 'fa-coins',
                        'CREDIT_TRANSFER': 'fa-building-columns',
                        'CARD_PAYMENT': 'fa-credit-card',
                        'SEPA_CREDIT_TRANSFER': 'fa-building-columns',
                        'SEPA_DIRECT_DEBIT': 'fa-money-check'
                    }[invoice.paymentMeans.name]|default('fa-circle-question') %}
                    <span class="ms-1 text-secondary fit-rows-phone-hidden"
                       title="{{ invoice.paymentMeans.name|trans }}"
                       aria-label="{{ invoice.paymentMeans.name|trans }}">
                        <i class="fa-solid {{ paymentMeansIcon }}" aria-hidden="true"></i>
                    </span>
                {% endif %}
            </td>
            <td>
                <a href="#" title="{{ 'button.details'|trans }}"
                   data-action="click->invoices#showInvoiceAction"
                   data-url="{{ path('invoices.get.invoice', {'id': invoice.id}) }}"
                   data-bs-toggle="modal" data-bs-target="#modalCenter">
                    <i class="fas fa-info-circle"></i></a>
                <a href="#" title="{{ 'button.edit'|trans }}"
                   data-action="click->invoices#showInvoiceAction"
                   data-edit="true"
                   data-url="{{ path('invoices.get.invoice', {'id': invoice.id}) }}"
                   data-bs-toggle="modal" data-bs-target="#modalCenter">
                    <i class="fas fa-edit"></i></a>
                {% set readiness = einvoiceReadiness[invoice.id] ?? null %}
                <a class="export-link"
                   href="{{ path('invoices.export.pdf', {'id': invoice.id, 'template': templateId }) }}"
                   title="{{ readiness and readiness.ready ? 'button.export.einvoicepdf'|trans : 'button.export.pdf'|trans }}" target="_blank">
                    <i class="fas fa-file-pdf"></i></a>
                {# Per invoice, not list-wide: with per-branch issuers the profile can differ. #}
                {% if readiness and readiness.profileKey == 'xrechnung' %}
                <a href="{{ path('invoices.export.xrechnung', {'id': invoice.id }) }}"
                    title="{{ 'button.export.xml'|trans }}">
                     <i class="fa-solid fa-file-code"></i></a>
                {% endif %}
                {% if readiness and readiness.configured %}
                    {% if readiness.ready %}
                        <span class="text-success" title="{{ 'invoice.einvoice.status.ready'|trans }}">
                            <i class="fa-solid fa-circle-check"></i></span>
                    {% elseif invoice.company is not empty %}
                        {# a company recipient is likely B2B, where the e-invoice matters → warning #}
                        <span class="text-warning" title="{{ 'invoice.einvoice.status.missing'|trans }}:&#10;{{ readiness.result.messageKeys|map(key => key|trans)|join("\n") }}">
                            <i class="fa-solid fa-triangle-exclamation"></i></span>
                    {% else %}
                        {# no company → likely B2C, where the e-invoice is not mandatory → neutral info #}
                        <span class="text-info" title="{{ 'invoice.einvoice.status.missing'|trans }}:&#10;{{ readiness.result.messageKeys|map(key => key|trans)|join("\n") }}">
                            <i class="fa-solid fa-circle-info"></i></span>
                    {% endif %}
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
<input id="page" type="hidden" name="page" value="{{ page }}" />
<div class="d-flex fit-rows-paging">
    {% include 'paginator.html.twig' with { 'url' : path('invoices.overview'), 'pagination_swipe': true } %}
</div>
</div>
